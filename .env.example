# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored, so keys in it never reach GitHub.

# Accounts and sync (optional). From Supabase: Project Settings → API Keys.
# Both are public by design and end up in the app bundle; row-level security
# (supabase/schema.sql) is what protects the data. Never put the secret key here.
# Leave them empty and the app runs without accounts, on this device only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Free key from https://fdc.nal.usda.gov/api-key-signup
# Only used on your computer by `npm run foods:import`; never sent to the app or Netlify.
FDC_API_KEY=
