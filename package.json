{
  "name": "fitness-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "foods:wafct": "node scripts/import-wafct.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "check:profile": "node scripts/profile-check.mjs",
    "check:workout": "node scripts/workout-check.mjs",
    "check:review": "node scripts/review-check.mjs",
    "check:audit": "node scripts/audit-check.mjs",
    "check:meals": "node scripts/meals-check.mjs",
    "check:all": "npm run check:audit && npm run check:profile && npm run check:workout && npm run check:review && npm run check:meals",
    "foods:import": "node --env-file-if-exists=.env.local scripts/import-usda.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "exceljs": "^4.4.0",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
